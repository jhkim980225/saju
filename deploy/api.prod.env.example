# 운영 API 환경 변수 — deploy/api.prod.env 로 복사해서 채운다. 이 파일은 저장소에 올리지 않는다(.gitignore).
# 전체 키 목록·발급처: docs/ENV_KEYS.md

# ── 필수 ─────────────────────────────────────────────────────────
# openssl rand -base64 48  (두 값을 다르게)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 관리자 API(환불·질문권 지급) — openssl rand -hex 24
ADMIN_API_TOKEN=
# 결제: 그로블
PAYMENT_PROVIDER=groble
GROBLE_WEBHOOK_SECRET=
# 상품ID=결제창링크,상품ID=결제창링크 … (docs/PAYMENTS.md 3.5)
GROBLE_PRODUCT_LINKS=
GROBLE_REF_PREFIX=saju

# ── 있으면 켜지는 것 ──────────────────────────────────────────────
# AI 상담·리포트 다듬기 (없으면 규칙 기반)
ANTHROPIC_API_KEY=
# 비밀번호 재설정 메일 (없으면 문의 안내로 대체)
RESEND_API_KEY=
MAIL_FROM=달빛사주 <no-reply@dalbitsaju.kr>
SUPPORT_EMAIL=
# 소셜 로그인 (없으면 버튼이 숨겨짐)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 나중에 ───────────────────────────────────────────────────────
# 푸시(FCM) — 앱 출시 때
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
DAILY_PUSH_ENABLED=false
# 광고 — 애드센스 승인 뒤
ADS_ENABLED=false
ADS_PROVIDER=none
