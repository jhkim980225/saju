# ════════════════════════════════════════════════════════════════
#  달빛사주 웹/앱 프론트엔드 환경 변수 (VITE_ 접두사 = 브라우저에 노출되는 "공개" 키만!)
#  비밀 키(secret)는 절대 여기에 넣지 마세요 — 서버(apps/api/.env)에만 둡니다.
# ════════════════════════════════════════════════════════════════

# API 주소 — 비우면 같은 출처의 /api/v1 (개발 시 Vite 프록시 → localhost:4000)
# Capacitor 앱 빌드에서는 반드시 절대 주소: https://api.dalbitsaju.kr/api/v1
VITE_API_BASE_URL=

# 결제 (서버 /config 의 tossClientKey 가 우선, 없을 때 사용)
VITE_TOSS_CLIENT_KEY=

# 카카오 JavaScript 키 — 카카오톡 공유 (developers.kakao.com > 앱 키)
VITE_KAKAO_JS_KEY=

# 분석/전환 추적
VITE_GA4_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
VITE_KAKAO_PIXEL_ID=

# 광고 — 웹: Google AdSense / 카카오 애드핏
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_RESULT_BOTTOM=
VITE_ADSENSE_SLOT_HOME_INFEED=
VITE_ADFIT_UNIT_RESULT_BOTTOM=
VITE_ADFIT_UNIT_HOME_INFEED=
# 띠별·별자리 운세 본문 중간(content_mid)
VITE_ADSENSE_SLOT_CONTENT_MID=
VITE_ADFIT_UNIT_CONTENT_MID=
# ── 앱(Capacitor) 빌드 전용 — 실제 값은 apps/web/.env.app 에 (npm run build:app = vite build --mode app)
# 웹 서비스 주소: 앱 소셜 로그인 redirectUri·유니버설 링크 기준
VITE_PUBLIC_WEB_URL=
VITE_DEEPLINK_HOSTS=
VITE_APP_URL_SCHEME=
# 광고 — 앱: Google AdMob 광고 단위 (비우면 Google 테스트 단위로 동작)
VITE_ADMOB_UNIT_REWARDED_CHAT_IOS=
VITE_ADMOB_UNIT_REWARDED_CHAT_ANDROID=
VITE_ADMOB_UNIT_BANNER_RESULT_IOS=
VITE_ADMOB_UNIT_BANNER_RESULT_ANDROID=
VITE_ADMOB_TESTING=

# 웹 푸시 (Firebase 웹 앱 설정)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
