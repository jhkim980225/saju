# 토스 미니앱 제출용 빌드 (npm run build:toss = vite build --mode toss) — 공개 값만 둔다
# 비어 있으면: 광고를 부르지 않고, 상점은 '준비 중'으로 보이며, 무료 기능은 그대로 동작한다.

# API 주소 — 토스 빌드는 절대 주소가 필요하다 (예: https://api.example.com/api/v1)
VITE_API_BASE_URL=

# 토스 광고 그룹 ID (콘솔 > 인앱 광고 > 광고 그룹 탭에서 행을 눌러 복사, ait.v2.live.… 형식)
# 보상형: 오늘 탭의 "앞으로의 운세 미리 보기"
VITE_TOSS_AD_REWARDED=
# 배너(리스트형): 무료 결과·토정비결·띠·별자리 하단
VITE_TOSS_AD_BANNER_RESULT=
# 배너(피드형): 오늘 탭·꿈해몽 본문
VITE_TOSS_AD_BANNER_FEED=

# 약관·개인정보 처리방침에 들어가는 사업자 정보 (src/toss/legal.ts) — 비어 있으면 화면에 "(출시 전 입력)"이 그대로 보인다
# 상호
VITE_TOSS_BIZ_NAME=
# 대표자
VITE_TOSS_BIZ_REPRESENTATIVE=
# 사업자등록번호 (예: 123-45-67890)
VITE_TOSS_BIZ_REG_NO=
# 통신판매업 신고번호 (예: 2026-서울강남-0000)
VITE_TOSS_BIZ_MAIL_ORDER_NO=
# 사업장 주소
VITE_TOSS_BIZ_ADDRESS=
# 고객 문의·환불 문의 이메일 (콘솔의 고객문의 이메일과 같게)
VITE_TOSS_BIZ_EMAIL=
# 고객 문의 전화
VITE_TOSS_BIZ_PHONE=
# 개인정보 보호책임자 이름
VITE_TOSS_BIZ_PRIVACY_OFFICER=
# 약관 시행일 (예: 2026년 12월 1일)
VITE_TOSS_BIZ_EFFECTIVE_DATE=
