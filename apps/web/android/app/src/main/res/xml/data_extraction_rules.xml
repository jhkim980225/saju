<?xml version="1.0" encoding="utf-8"?>
<!--
  백업·기기 이전 규칙 (Android 12 이상, android:dataExtractionRules). 이유는 backup_rules.xml 참고.
  Keystore 로 암호화한 세션 토큰 파일만 클라우드 백업과 기기 간 이전에서 제외한다 → 새 기기에서는 다시 로그인.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
