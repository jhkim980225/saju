{
  "name": "@saju/web",
  "version": "0.1.0",
  "private": true,
  "description": "달빛사주 웹 프론트엔드 (React + Vite) — Capacitor 로 iOS/Android 앱 포팅",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && npm run prerender",
    "prerender": "tsx scripts/prerender.mts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:app": "tsc -p tsconfig.json --noEmit && vite build --mode app && cap sync",
    "cap:sync": "cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "cap:doctor": "cap doctor",
    "build:app:android": "tsc -p tsconfig.json --noEmit && vite build --mode app && cap sync android",
    "build:app:ios": "tsc -p tsconfig.json --noEmit && vite build --mode app && cap sync ios"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-printer": "^8.1.7",
    "@capgo/native-purchases": "^8.9.2",
    "@saju/core": "0.1.0",
    "@saju/shared": "0.1.0",
    "@tanstack/react-query": "^5.104.1",
    "lucide-react": "^1.55.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.7"
  }
}
