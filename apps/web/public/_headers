# Cloudflare Workers 정적 파일 응답 헤더 (빌드 결과 dist/_headers 로 복사된다)
# 해시가 붙은 빌드 파일은 내용이 바뀌면 이름도 바뀐다 — 1년 캐시
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 타로 카드·브랜드 그림과 글꼴은 거의 바뀌지 않는다 — 하루 캐시.
# /tarot/* 로 쓰면 사전 렌더링한 /tarot·/tarot/daily 화면 HTML 까지 캐시돼, 배포 뒤 지워진 JS 를 불러 화면이 깨진다
/tarot/cards/*
  Cache-Control: public, max-age=86400
/tarot/back.webp
  Cache-Control: public, max-age=86400
/brand/*
  Cache-Control: public, max-age=86400
/fonts/*
  Cache-Control: public, max-age=2592000

/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600

# 모든 화면 — 보안 헤더(API 응답은 Worker 의 secureHeaders 가 붙인다)
/*
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
