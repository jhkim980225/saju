{
  "name": "@saju/api",
  "version": "0.1.0",
  "private": true,
  "description": "사주 서비스 백엔드 API (Cloudflare Workers · Hono · D1)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/local.mjs --port 4000",
    "deploy": "wrangler deploy",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@saju/core": "0.1.0",
    "@saju/shared": "0.1.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "jose": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@libsql/client": "^0.17.0",
    "drizzle-kit": "^0.31.11",
    "miniflare": "5.20261023.1-beta",
    "wrangler": "^4.154.0"
  }
}
