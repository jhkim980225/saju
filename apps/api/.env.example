# ════════════════════════════════════════════════════════════════
#  달빛사주 API 환경 변수 — 복사해서 .env 로 사용 (cp .env.example .env)
#  외부 연동 키는 모두 "선택"입니다. 비어 있으면 해당 기능은 목업/규칙 기반으로 동작하거나
#  NOT_CONFIGURED(501) 를 반환합니다. 발급처·설정법은 docs/ENV_KEYS.md 참고.
# ════════════════════════════════════════════════════════════════

# ── 서버 ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_NAME=달빛사주
# CORS 허용 오리진(콤마 구분) — 웹 주소 + Capacitor 앱 오리진
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost,https://localhost
# 결제 성공/실패·소셜 로그인 리다이렉트 기준 웹 주소 (운영은 https 필수)
PUBLIC_WEB_URL=http://localhost:5173
DATABASE_PATH=./data/saju.db
# 운영에서는 반드시 32자 이상 임의 문자열로 교체 (openssl rand -base64 48)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SEC=3600
REFRESH_TOKEN_TTL_DAYS=30
RATE_LIMIT_PER_MIN=120
# 관리자 API(환불·질문권 지급) 호출용 토큰 — 헤더 x-admin-token
ADMIN_API_TOKEN=
# 신규 가입 보너스 질문권(무상)
SIGNUP_BONUS_CREDITS=0

# ── AI 해석/상담 (Anthropic Claude) ──────────────────────────────
# 비어 있으면 리포트는 규칙 기반, 상담은 기본 답변(질문권 차감 없음)
ANTHROPIC_API_KEY=
# 상담·리포트 다듬기 모델 / 타로 이야기 모델
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_MODEL_PREMIUM=claude-sonnet-5-5
AI_CHAT_CREDIT_COST=1

# ── 결제 ─────────────────────────────────────────────────────────
# mock(개발용·운영 금지) | groble(사용 중) | toss | portone
PAYMENT_PROVIDER=mock
# 그로블 — 내 스토어 → 연동 → 웹훅 등록 때 받은 시크릿 (docs/PAYMENTS.md 3.5)
GROBLE_WEBHOOK_SECRET=
# 우리 상품 ID → 그로블 결제창 링크, 콤마 구분. 결제창 가격은 catalog.ts 판매가와 같게
# 예: chat_pack_10=https://groble.im/payment/abc123,report_saju_lifetime=https://groble.im/payment/def456
GROBLE_PRODUCT_LINKS=
# 한 그로블 계정을 다른 서비스와 같이 쓸 때만 — 이 서비스의 ref 접두어(영숫자 1~16자). 다른 접두어의 알림은 건너뜀
GROBLE_REF_PREFIX=
# 토스페이먼츠 결제위젯 연동 키 (gck_/gsk_) — 개발자센터 > API 키
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=
# 포트원 V2 — 콘솔 > 결제 연동
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
# Apple App Store Server API (인앱결제 검증)
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_BUNDLE_ID=kr.dalbitsaju.app
# 받아들일 App Store 거래·알림 환경(콤마 구분). 운영도 App Review 가 샌드박스로 결제하므로 기본값 유지.
# 스테이징 서버는 Sandbox 만 (비우면 Production,Sandbox)
APPLE_IAP_ENVIRONMENTS=Production,Sandbox
# Google Play Developer API (인앱결제 검증) — 서비스 계정 JSON 문자열
GOOGLE_PLAY_PACKAGE_NAME=kr.dalbitsaju.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Google Play 실시간 개발자 알림(RTDN) — Pub/Sub 푸시 구독의 인증 설정과 같게 (docs/PAYMENTS.md 3.4)
# audience: 구독의 "대상"(비워 두었다면 푸시 엔드포인트 URL 그대로)
GOOGLE_PLAY_RTDN_AUDIENCE=
# 푸시 구독에 지정한 서비스 계정 이메일
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT=

# ── 소셜 로그인 ──────────────────────────────────────────────────
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── 푸시 (Firebase Cloud Messaging HTTP v1, 서비스 계정) ─────────
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── 메일 (Resend HTTPS API) — 비밀번호 재설정 링크 발송 ──────────
# 비어 있으면 "비밀번호 찾기"는 SUPPORT_EMAIL 문의 안내로 대체 (resend.com > API Keys, 발신 도메인 인증 필요)
RESEND_API_KEY=
# 발신자 — 인증한 도메인의 주소. 예: 달빛사주 <no-reply@dalbitsaju.kr>
MAIL_FROM=
# 고객 문의 주소 (메일 연동이 없을 때 화면에 안내)
SUPPORT_EMAIL=

# ── 광고 (서버 주도 노출 제어) ───────────────────────────────────
ADS_ENABLED=false
# adsense | adfit | admob | none
ADS_PROVIDER=none

# 매일 08:00 KST 오늘의 운세 푸시 (FCM 키 필요, 여러 서버 중 한 대만 true)
DAILY_PUSH_ENABLED=false

# 앱 보상형 광고(AdMob SSV) — 1회 보상 질문권 / 하루 한도
REWARDED_AD_CREDITS=1
REWARDED_AD_DAILY_LIMIT=3

# 보안 — 인증 경로 분당 제한 / 리버스 프록시 홉 수(nginx 뒤면 1, 직접 노출이면 0)
AUTH_RATE_LIMIT_PER_MIN=10
TRUST_PROXY_HOPS=0
# 우리 앱의 AdMob 보상형 광고 단위(콤마 구분) — 운영에서 비어 있으면 SSV 지급 거부
ADMOB_REWARDED_AD_UNITS=
