// 달달사주 — Cloudflare Worker 하나로 웹(정적 파일)과 API 를 낸다. 배포: docs/DEPLOY.md
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dalbit-saju",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-20",
  // node:crypto(scrypt·HMAC·X509) 등 Node API — 결제 서명 검증·비밀번호 해시가 쓴다
  "compatibility_flags": ["nodejs_compat"],
  // D1 가까이에서 실행(요청마다 DB 를 여러 번 오가므로 사용자 가까이보다 DB 가까이가 빠르다)
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },

  // 운영 도메인(같은 계정의 Cloudflare 존). DNS 레코드와 인증서는 배포할 때 Cloudflare 가 만든다.
  // www 도 같은 화면을 내고, 사전 렌더링한 canonical 은 www 없는 주소를 가리킨다
  "routes": [
    { "pattern": "daldalsaju.com", "custom_domain": true },
    { "pattern": "www.daldalsaju.com", "custom_domain": true }
  ],
  "workers_dev": true,

  // 웹 빌드 결과(npm run build -w @saju/web). /api/* 와 /health 만 Worker 코드가 먼저 받는다
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"],
    // 없는 주소는 index.html(SPA 라우팅)
    "not_found_handling": "single-page-application",
    // 사전 렌더링한 <경로>/index.html 을 끝 슬래시 없는 대표 주소(/today)로 낸다
    "html_handling": "drop-trailing-slash"
  },

  // wrangler d1 create dalbit-saju --location apac 로 만든 뒤 database_id 를 바꿔 넣는다
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dalbit-saju",
      "database_id": "80cf65da-7505-42e1-b6ac-6d0607026742",
      "migrations_dir": "drizzle"
    }
  ],

  // 리포트 AI 다듬기 — 응답 뒤 작업. wrangler queues create dalbit-saju-jobs
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "dalbit-saju-jobs" }],
    "consumers": [{ "queue": "dalbit-saju-jobs", "max_batch_size": 1, "max_retries": 2 }]
  },

  // 요청 수 제한(접속 IP 기준, 60초 창). namespace_id 는 계정 안에서 겹치지 않는 정수 — 같은 계정의 다른 Worker 와 겹치면 횟수를 같이 센다
  // API 전체(결제 웹훅·스토어 알림·AdMob SSV 제외) · 인증(로그인·가입·비밀번호) · 세션 유지(게스트 시작·토큰 갱신) · 관리자
  "ratelimits": [
    { "name": "RATE_LIMIT_API", "namespace_id": "73101", "simple": { "limit": 120, "period": 60 } },
    { "name": "RATE_LIMIT_AUTH", "namespace_id": "73102", "simple": { "limit": 10, "period": 60 } },
    { "name": "RATE_LIMIT_ADMIN", "namespace_id": "73103", "simple": { "limit": 20, "period": 60 } },
    { "name": "RATE_LIMIT_SESSION", "namespace_id": "73104", "simple": { "limit": 60, "period": 60 } }
  ],

  // 매일 23:00 UTC = 08:00 KST 오늘의 운세 푸시(DAILY_PUSH_ENABLED=true 이고 FCM 키가 있을 때만 보낸다)
  // 10분마다: 결제 확인 지연 알림·묶음 알림 정리(src/worker.ts). 08:00 KST 에는 운영 하루 요약도 보낸다
  "triggers": { "crons": ["0 23 * * *", "*/10 * * * *"] },

  // 비밀이 아닌 설정. 키·비밀번호는 wrangler secret put <이름> (docs/ENV_KEYS.md)
  "vars": {
    "NODE_ENV": "production",
    "APP_NAME": "달달사주",
    "PUBLIC_WEB_URL": "https://daldalsaju.com",
    "CORS_ORIGINS": "https://daldalsaju.com,capacitor://localhost,https://localhost,http://localhost",
    "PAYMENT_PROVIDER": "groble",
    // 그로블 계정을 다른 서비스와 같이 쓴다 → ref 가 saju-<주문 ID>, 다른 접두어의 결제 알림은 건너뜀
    "GROBLE_REF_PREFIX": "saju",
    "DAILY_PUSH_ENABLED": "true"
  }
}
